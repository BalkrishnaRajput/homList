# PostgreSQL-compatible application database. Keep server-only and uncommitted.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# Supabase project base URL (https://PROJECT_REF.supabase.co), never /rest/v1.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co

# Public browser key only: publishable key, or the legacy anon key.
# Never place the service-role key in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_SUPABASE_KEY

# Optional direct PostgreSQL URL for migration tools when DATABASE_URL uses a
# pooled connection. Keep this server-only and uncommitted.
# DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME
